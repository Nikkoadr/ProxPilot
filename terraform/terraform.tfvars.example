# Proxmox Cluster Automation
# ==========================
# Isilah dengan kredensial Proxmox Anda

proxmox_api_url = "https://192.168.1.100:8006/api2/json"
proxmox_username = "root@pam"
proxmox_password = ""

vm_start_on_create = true
ssh_user = "ubuntu"
ssh_private_key = "~/.ssh/id_rsa"

# Template Ubuntu cloud-init di Proxmox
clone_template = "ubuntu-22-04-template"
